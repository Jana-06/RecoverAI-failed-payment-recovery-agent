# RecoverAI environment — copy to .env and fill in what you have. Everything is optional.

# --- Gemini (writes customer message copy only; validated) ---
# Without this, the app uses the built-in template fallback and still works fully.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Razorpay (TEST MODE ONLY) ---
# Leave empty to use the in-memory SimulatedRazorpayClient (default, no network).
# If you set keys, use test-mode keys from the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any random string; webhook requests must HMAC-SHA256-sign the raw body with it.
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret

# --- App ---
# SQLite location (created automatically). Defaults to data/recoverai.db
RECOVERAI_DB=data/recoverai.db

# --- Guardrail knobs (defaults shown) ---
DAILY_MESSAGE_BUDGET=200
HIGH_VALUE_PAISE=2500000

# --- Demo fault injection ---
# CHAOS=1 makes the LLM and Razorpay client randomly fail so you can watch the
# app degrade gracefully (fallbacks, skipped actions, audit trail errors).
CHAOS=0
